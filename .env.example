# RemoDesk Environment Configuration

# Core Application
PROJECT_NAME="RemoDesk Remote Desktop Gateway"
VERSION="1.0.0"

# Security & JWT (Generate a 64-char random hex key in production)
SECRET_KEY="replace-with-a-very-secure-random-secret-key-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: local SQLite; Production: PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./remodesk.db"
# DATABASE_URL="postgresql+asyncpg://remodesk:secure_db_pass@localhost:5432/remodesk_db"

# WebRTC STUN & TURN
TURN_SERVER_URL="turn.yourdomain.com:3478"
TURN_SECRET="replace-with-coturn-shared-secret"
TURN_TTL_SECONDS=14400

# CORS Allowed Origins
CORS_ORIGINS=["*"]
